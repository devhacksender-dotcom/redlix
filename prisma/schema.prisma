// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ContactInquiry {
  id               Int      @id @default(autoincrement())
  name             String
  email            String
  phone            String?
  company          String?
  website          String?
  businessType     String?
  turnover         String?
  service          String?
  budget           String?
  timeline         String?
  preferredDateTime DateTime?
  timezone         String?
  preferredMode    String?
  message          String
  createdAt        DateTime @default(now())
  isRead           Boolean  @default(false)

  @@map("contact_inquiries")
}

model Employee {
  id              Int      @id @default(autoincrement())
  name            String
  email           String   @unique
  role            String
  password        String   @default("redlix_emp_2026")
  offerLetterLink String?
  resetToken      String?
  resetTokenExpiry DateTime?
  phone           String?
  upiId           String?
  fatherName      String?
  mobile          String?
  altEmail        String?
  address         String?
  joinedAt        DateTime @default(now())
  createdAt       DateTime @default(now())

  tasks           Task[]
  attendance      Attendance[]

  @@map("employees")
}

model SupportTicket {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@map("support_tickets")
}

model Client {
  id              Int      @id @default(autoincrement())
  companyName     String
  appName         String?
  clientName      String
  email           String   @unique
  phone           String?
  meetingTemplate String?
  meetingTime     DateTime?
  developerName   String?
  meetingLink     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("clients")
}

model InternSupport {
  id           Int      @id @default(autoincrement())
  name         String
  batchNumber  String
  college      String
  email        String
  problemPage  String
  description  String
  status       String   @default("pending")
  createdAt    DateTime @default(now())

  @@map("intern_support")
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  status      String   @default("pending") // pending, in_progress, completed
  deadline    DateTime?
  employeeId  Int
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tasks")
}

model Attendance {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  punchIn     DateTime  @default(now())
  punchOut    DateTime?
  workMinutes Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("attendance")
}
